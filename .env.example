# Copy to .env for local release builds. CI injects these same names.
# Use a quoted multiline value for PEM or P8 text.
XBOND_RELEASE_PUBLIC_KEY=
XBOND_RELEASE_PRIVATE_KEY=
XBOND_TAURI_PUBLIC_KEY=
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# The keystore, Apple P12 files and profiles use single-line Base64.
ANDROID_KEYSTORE_BASE64=
ANDROID_STORE_PASSWORD=
ANDROID_KEY_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_SIGNER_SHA256=

APPLE_TEAM_ID=
APPLE_SIGNING_IDENTITY=
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY=
# macOS notarization falls back to these Apple ID credentials when ASC_KEY is unset.
APPLE_ID=
APPLE_PASSWORD=
IOS_DISTRIBUTION_P12=
IOS_DISTRIBUTION_PASSWORD=
IOS_APP_PROFILE=
IOS_TUNNEL_PROFILE=

# Optional Authenticode thumbprint after importing the certificate on Windows.
WINDOWS_CERTIFICATE_THUMBPRINT=
