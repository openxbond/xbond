{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XBond",
        "width": 1200,
        "height": 720,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xbond", "clash", "sing-box"]
      }
    }
  }
}
