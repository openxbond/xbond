# Editor, tooling and dependency state
.idea/
.impeccable
__pycache__/
node_modules/

# Local build outputs
/dist/
/dist-desktop/
/xbond
/xbond.exe
/xbond.exe.old

# Tauri shell (desktop and mobile, repo-root src-tauri)
src-tauri/target/
src-tauri/gen/schemas/
src-tauri/binaries/xbond-daemon-*
plugins/xbond/target/
plugins/xbond/Cargo.lock

# Compiled JSX and coverage output
packages/client-ui/src/**/*.jsx
packages/*/tests/**/*.jsx
packages/*/tests/__coverage__/

# Wintun and rollback binaries can be extracted beside a copied executable
*.exe~
/wintun.dll

# Runtime state when the repo root is used as XBOND_DATA_DIR. Anchor these:
# an unanchored `subscriptions/` also hides packages/client-ui/src/features/configuration/subscriptions
# on case-insensitive filesystems.
/subscriptions/
/subscriptions.json
/runtime_state.json
/sysproxy.snapshot.json
/localapi.token
/localapi.addr

# Local data and logs
*.db
*.db-*
*.log
*~

# Local release configuration and signing material
/.env
/.env.*
!/.env.example
/keys/

# Release outputs
/release/
/release-assets/

# Mobile gomobile bind outputs (consumed by the xbond plugin)
src-tauri/gen/android/.kotlin/
plugins/xbond/android/libs/xbond-mobile.aar
plugins/xbond/android/libs/xbond-mobile-sources.jar
plugins/xbond/ios/Frameworks/XBondMobile.xcframework/
plugins/xbond/ios/build/

# Plugin permission artifacts regenerated by the tauri-plugin build script
plugins/xbond/permissions/autogenerated/
plugins/xbond/permissions/schemas/
plugins/xbond/.tauri/
plugins/xbond/android/.gradle/

# Local task records; only the README is tracked
/docs/tasks/*
!/docs/tasks/README.md

# ZCode session workspace
.zcode/

temp/
.temp/
