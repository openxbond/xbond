<?xml version="1.0" encoding="utf-8"?>
<!-- Cold-start splash icon, API 31+ (see values-v31/themes.xml): the brand
     glyph wrapped in an AnimatedVectorDrawable that keeps the same gentle
     3.4s float loop as the desktop splash window and the in-app connecting
     state (connect-wait classes in styles/app.css), so every host shares
     one "brand mark breathing" idle language while the daemon connection
     settles. The loop starts at translateY(0): any host that never starts
     the animation (static window background frame, screenshot) still shows
     the complete, correctly positioned mark. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/xbond_splash_glyph">
    <target
        android:name="mark"
        android:animation="@animator/xbond_splash_float" />
</animated-vector>
