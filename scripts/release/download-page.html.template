          <path d="M 320 156 C 375 128, 442 132, 515 168 C 582 201, 642 222, 712 204 C 732 199, 748 190, 760 180 L 760 226 C 712 246, 638 242, 558 212 C 472 180, 398 148, 320 156 Z" fill="url(#xb-crest)" />
