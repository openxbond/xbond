  </main>
  <script>
    const STRINGS = @@stringsJson@@;
    const LOCALES = @@localesJson@@;
    const select = document.getElementById("lang");
    let currentLocale = "en";
    const docker = {
      mode: /Macintosh|Windows/.test(navigator.userAgent) ? "port" : "tun",
      form: "run",
      tz: "Asia/Shanghai",
    };
    try {
      docker.tz = Intl.DateTimeFormat().resolvedOptions().timeZone || docker.tz;
    } catch {}
    const DOCKER_IMAGE = "ghcr.io/openxbond/xbond:latest";
    const DOCKER_PORTS = ["127.0.0.1:7890:7890", "127.0.0.1:19090:19090"];
    const shellQuote = (value) => "'" + value.replace(/'/g, "'\\''") + "'";
    function dockerCommands() {
      const tun = docker.mode === "tun";
      const environment = { TZ: docker.tz };
      if (tun)
        Object.assign(environment, {
          XBOND_TAKEOVER_MODE: "tun",
          XBOND_MIXED_PORT: "7890",
          XBOND_DASHBOARD_LISTEN: "127.0.0.1:19090",
        });
      const runLines = [
        "docker run -d",
        "  --pull always",
        "  --name xbond",
        "  --restart unless-stopped",
      ];
      if (tun)
        runLines.push(
          "  --network host",
          "  --cap-add NET_ADMIN",
          "  --device /dev/net/tun",
        );
      else for (const port of DOCKER_PORTS) runLines.push(`  -p ${port}`);
      runLines.push("  -v xbond-data:/data");
      for (const [key, value] of Object.entries(environment))
        runLines.push(`  -e ${key}=${shellQuote(value)}`);
      runLines.push(`  ${DOCKER_IMAGE}`);
      const composeLines = [
        "services:",
        "  xbond:",
        `    image: ${DOCKER_IMAGE}`,
        "    container_name: xbond",
        "    restart: unless-stopped",
        "    pull_policy: always",
      ];
      if (tun)
        composeLines.push(
          "    network_mode: host",
          "    cap_add:",
          "      - NET_ADMIN",
          "    devices:",
          "      - /dev/net/tun:/dev/net/tun",
        );
      else {
        composeLines.push("    ports:");
        for (const port of DOCKER_PORTS) composeLines.push(`      - "${port}"`);
      }
      composeLines.push("    environment:");
      for (const [key, value] of Object.entries(environment))
        composeLines.push(`      ${key}: ${JSON.stringify(value).replaceAll("$", "$$")}`);
      composeLines.push(
        "    volumes:",
        "      - xbond-data:/data",
        "volumes:",
        "  xbond-data:",
        "    name: xbond-data",
      );
      return { run: runLines.join(" \\\n"), compose: composeLines.join("\n") + "\n" };
    }
    function detect() {
      try {
        const saved = localStorage.getItem("xbond-lang");
        if (saved && STRINGS[saved]) return saved;
      } catch {}
      for (const tag of navigator.languages || []) {
        const lower = tag.toLowerCase();
        if (/^(zh-tw|zh-hk|zh-hant)/.test(lower)) return "zh-HK";
        if (lower.startsWith("zh")) return "zh";
        if (lower.startsWith("ko")) return "ko";
        if (lower.startsWith("fa")) return "fa";
      }
      return "en";
    }
    function rebuildDocker() {
      const commands = dockerCommands();
      document.getElementById("docker-cmd-code").textContent =
        docker.form === "run" ? commands.run : commands.compose;
      const strings = STRINGS[currentLocale] || STRINGS.en;
      document.getElementById("mode-tip").textContent =
        docker.mode === "tun" ? strings.tipTun : strings.tipPort;
      for (const button of document.querySelectorAll(".mode-btn"))
        button.classList.toggle("active", button.dataset.mode === docker.mode);
      for (const tab of document.querySelectorAll(".code-tab"))
        tab.classList.toggle("active", tab.dataset.form === docker.form);
    }
    function apply(locale) {
      const strings = STRINGS[locale] || STRINGS.en;
      const meta = LOCALES[locale] || LOCALES.en;
      document.documentElement.lang = meta.lang;
      document.documentElement.dir = meta.dir;
      for (const el of document.querySelectorAll("[data-i18n]")) {
        const value = strings[el.getAttribute("data-i18n")];
        if (value) el.textContent = value;
      }
      document.title = strings.title;
      currentLocale = locale;
      select.value = locale;
      select.setAttribute("aria-label", strings.langAria);
      for (const button of document.querySelectorAll(".copy-btn"))
        button.setAttribute("aria-label", strings.copy);
      try {
        localStorage.setItem("xbond-lang", locale);
      } catch {}
      rebuildDocker();
    }
    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.appendChild(area);
        area.select();
        let copied = false;
        try {
          copied = document.execCommand("copy");
        } catch {}
        area.remove();
        return copied;
      }
    }
    for (const [button, source] of [
      ["pull-copy", "pull-code"],
      ["cmd-copy", "docker-cmd-code"],
    ]) {
      const copyButton = document.getElementById(button);
      const copySource = document.getElementById(source);
      let revert;
      copyButton.addEventListener("click", async () => {
        if (!(await copyText(copySource.textContent))) return;
        const strings = STRINGS[currentLocale] || STRINGS.en;
        clearTimeout(revert);
        copyButton.classList.add("copied");
        copyButton.setAttribute("aria-label", strings.copied);
        revert = setTimeout(() => {
          copyButton.classList.remove("copied");
          copyButton.setAttribute("aria-label", strings.copy);
        }, 1600);
      });
    }
    for (const button of document.querySelectorAll(".mode-btn"))
      button.addEventListener("click", () => {
        docker.mode = button.dataset.mode;
        rebuildDocker();
      });
    for (const tab of document.querySelectorAll(".code-tab"))
      tab.addEventListener("click", () => {
        docker.form = tab.dataset.form;
        rebuildDocker();
      });
    select.addEventListener("change", () => apply(select.value));
    apply(detect());
  </script>
</html>
