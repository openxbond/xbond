{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XBond",
  "version": "0.3.0",
  "identifier": "net.xbond.app",
  "build": {
    "beforeDevCommand": "pnpm dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:desktop",
    "frontendDist": "../../../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XBond",
        "width": 1140,
        "height": 780,
        "minWidth": 840,
        "minHeight": 580,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' http://at.alicdn.com https://at.alicdn.com",
        "connect-src": "ipc: http: https: ws: wss:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["xbond", "clash"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
