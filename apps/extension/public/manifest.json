{
  "manifest_version": 3,
  "name": "XBond",
  "short_name": "XBond",
  "version": "0.1.0",
  "description": "XBond browser proxy: TLS proxy with account-bound ingress, no native client required.",
  "minimum_chrome_version": "108",
  "permissions": [
    "proxy",
    "webRequest",
    "webRequestAuthProvider",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": ["http://*/*", "https://*/*", "ws://*/*", "wss://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "XBond",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "options_ui": {
    "page": "src/page/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
