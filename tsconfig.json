{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "es2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "paths": {
      "@xbond/client/*": ["./packages/client/src/*.ts"],
      "@xbond/client-ui/bootstrap": ["./packages/client-ui/src/index.ts"],
      "@assets": ["./packages/client-ui/src/assets"],
      "@assets/*": ["./packages/client-ui/src/assets/*"],
      "@lib": ["./packages/client-ui/src/lib"],
      "@lib/*": ["./packages/client-ui/src/lib/*"],
      "@components": ["./packages/client-ui/src/components"],
      "@components/*": ["./packages/client-ui/src/components/*"],
      "@containers": ["./packages/client-ui/src/containers"],
      "@containers/*": ["./packages/client-ui/src/containers/*"],
      "@i18n": ["./packages/client-ui/src/i18n"],
      "@i18n/*": ["./packages/client-ui/src/i18n/*"],
      "@stores": ["./packages/client-ui/src/stores"],
      "@stores/*": ["./packages/client-ui/src/stores/*"],
      "@models": ["./packages/client-ui/src/models"],
      "@models/*": ["./packages/client-ui/src/models/*"],
      "@styles": ["./packages/client-ui/src/styles"],
      "@styles/*": ["./packages/client-ui/src/styles/*"]
    }
  },
  "include": [
    "packages/*/src",
    "apps/*/src",
    "scripts",
    "vite.config.ts",
    "uno.config.ts"
  ]
}
