{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "es2022"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "paths": {
      "@xbond/client/*": ["./packages/client/src/*.ts"],
      "@/*": ["./packages/client-ui/src/*"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "scripts", "vite.config.ts"]
}
