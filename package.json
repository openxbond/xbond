{
  "name": "xbond",
  "version": "0.3.0",
  "private": true,
  "description": "XBond CLI, desktop and mobile clients, and web dashboard.",
  "keywords": [
    "clash",
    "dashboard",
    "xbond"
  ],
  "homepage": "https://openxbond.github.io/xbond/",
  "bugs": {
    "url": "https://github.com/openxbond/xbond/issues"
  },
  "license": "MIT",
  "author": "openxbond <no-reply@xbond.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openxbond/xbond.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --experimental-strip-types --test packages/client/tests/*.test.ts packages/client-ui/tests/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm check:architecture && oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cli:build": "go build -tags \"with_gvisor,with_quic,with_utls,with_clash_api\" ./cmd/xbond",
    "cli:test": "go test -tags \"with_gvisor,with_quic,with_utls,with_clash_api\" ./...",
    "cli:vet": "go vet -tags \"with_gvisor,with_quic,with_utls,with_clash_api\" ./...",
    "cli:check": "pnpm cli:vet && pnpm cli:test && pnpm cli:build",
    "tauri": "tauri",
    "desktop": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "dev:desktop": "vite --mode tauri --host 127.0.0.1 --port 1420",
    "build:desktop": "vite build --mode tauri",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:fmt:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "mobile:check": "node --experimental-strip-types scripts/mobile.ts check",
    "mobile:bind:android": "node --experimental-strip-types scripts/mobile.ts bind:android",
    "mobile:bind:ios": "node --experimental-strip-types scripts/mobile.ts bind:ios",
    "release:package": "node --experimental-strip-types scripts/artifact.ts package",
    "release:validate": "node --experimental-strip-types scripts/artifact.ts validate",
    "release:transfer": "node --experimental-strip-types scripts/transfer.ts",
    "test:client": "node --experimental-strip-types --test packages/client/tests/*.test.ts",
    "check:architecture": "node --experimental-strip-types scripts/check-architecture.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-wind3": "^66.10.5",
    "@vitejs/plugin-react": "^6.1.2",
    "oxc-parser": "^0.150.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.82.0",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
