{
  "name": "xbond",
  "version": "0.3.0",
  "private": true,
  "description": "XBond CLI, desktop and mobile clients, and web dashboard.",
  "keywords": [
    "clash",
    "dashboard",
    "xbond"
  ],
  "homepage": "https://openxbond.github.io/xbond/",
  "bugs": {
    "url": "https://github.com/openxbond/xbond/issues"
  },
  "license": "MIT",
  "author": "openxbond <no-reply@xbond.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openxbond/xbond.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode tauri --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "build:desktop": "vite build --mode tauri",
    "test": "node --test packages/client/tests/*.test.ts packages/client-ui/tests/*.test.ts scripts/*.test.ts",
    "test:watch": "node --test --watch packages/client/tests/*.test.ts packages/client-ui/tests/*.test.ts scripts/*.test.ts",
    "test:client": "node --test packages/client/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm check:architecture && oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:architecture": "node scripts/check-architecture.ts",
    "cli:build": "node scripts/go.ts build",
    "cli:run": "node scripts/go.ts run",
    "cli:test": "node scripts/go.ts test",
    "cli:vet": "node scripts/go.ts vet",
    "cli:fmt": "node scripts/go.ts fmt",
    "cli:fmt:check": "node scripts/go.ts fmt:check",
    "cli:check": "node scripts/go.ts check",
    "tauri": "tauri",
    "desktop": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:check": "cargo check --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "desktop:fmt:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "mobile:check": "node scripts/mobile.ts check",
    "mobile:bind:android": "node scripts/mobile.ts bind:android",
    "mobile:bind:ios": "node scripts/mobile.ts bind:ios",
    "release:package": "node scripts/artifact.ts package",
    "release:validate": "node scripts/artifact.ts validate",
    "release:transfer": "node scripts/transfer.ts",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-wind3": "^66.10.5",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxc-parser": "^0.150.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.82.0",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
