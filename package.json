{
  "name": "xbond",
  "version": "0.3.0",
  "private": true,
  "description": "XBond CLI, desktop and mobile clients, and web dashboard.",
  "keywords": [
    "xbond",
    "clash",
    "dashboard"
  ],
  "homepage": "https://openxbond.github.io/xbond/",
  "bugs": {
    "url": "https://github.com/openxbond/xbond/issues"
  },
  "license": "MIT",
  "author": "openxbond <no-reply@xbond.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openxbond/xbond.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --experimental-strip-types --test web/tests/*.test.ts scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "cli:build": "go build -tags \"with_gvisor,with_quic,with_utls,with_clash_api\" ./cmd/xbond",
    "cli:test": "go test -tags \"with_gvisor,with_quic,with_utls,with_clash_api\" ./...",
    "cli:vet": "go vet -tags \"with_gvisor,with_quic,with_utls,with_clash_api\" ./...",
    "cli:check": "pnpm cli:vet && pnpm cli:test && pnpm cli:build",
    "tauri": "tauri",
    "desktop": "tauri dev --config tauri/tauri.conf.json",
    "dev:desktop": "vite --mode tauri --host 127.0.0.1 --port 1420",
    "build:desktop": "vite build --mode tauri",
    "desktop:build": "tauri build --config tauri/tauri.conf.json",
    "desktop:check": "cargo check --manifest-path tauri/Cargo.toml",
    "desktop:fmt:check": "cargo fmt --manifest-path tauri/Cargo.toml --check",
    "mobile:check": "node --experimental-strip-types scripts/mobile.ts check",
    "mobile:bind:android": "node --experimental-strip-types scripts/mobile.ts bind:android",
    "mobile:bind:ios": "node --experimental-strip-types scripts/mobile.ts bind:ios",
    "release:package": "node --experimental-strip-types scripts/artifact.ts package",
    "release:validate": "node --experimental-strip-types scripts/artifact.ts validate",
    "release:transfer": "node --experimental-strip-types scripts/transfer.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "@react-hookz/web": "^26.1.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "eventemitter3": "^5.0.4",
    "flag-icons": "^7.6.0",
    "i18next": "^26.5.11",
    "immer": "^11.1.21",
    "jotai": "^3.0.1",
    "jotai-immer": "^0.4.3",
    "neverthrow": "^8.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.4",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.3",
    "remeda": "^2.51.0",
    "swr": "^2.5.1",
    "use-immer": "^0.11.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unocss/preset-wind3": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.82.0",
    "sass": "^1.105.1",
    "type-fest": "^5.10.0",
    "typescript": "^7.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
