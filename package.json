{
  "name": "xbond",
  "version": "0.3.0",
  "private": true,
  "description": "XBond CLI, desktop and mobile clients, and web dashboard.",
  "keywords": [
    "clash",
    "dashboard",
    "xbond"
  ],
  "homepage": "https://openxbond.github.io/xbond/",
  "bugs": {
    "url": "https://github.com/openxbond/xbond/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "openxbond <no-reply@xbond.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openxbond/xbond.git"
  },
  "type": "module",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "setup:desktop": "node scripts/dev/setup.ts desktop",
    "setup:android": "node scripts/dev/setup.ts android",
    "setup:ios": "node scripts/dev/setup.ts ios",
    "setup:release": "node scripts/dev/setup.ts release",
    "dev": "vite",
    "dev:desktop": "tauri dev --config src-tauri/tauri.desktop.conf.json --features desktop",
    "dev:android": "node scripts/dev/mobile.ts dev:android",
    "dev:ios": "node scripts/dev/mobile.ts dev:ios",
    "build": "vite build",
    "build:desktop": "tauri build --no-bundle --config src-tauri/tauri.desktop.conf.json --features desktop",
    "package:desktop": "node scripts/dev/package-desktop.ts",
    "package:android": "node scripts/dev/mobile.ts package:android",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:web": "pnpm check && pnpm build && node scripts/check/check-web-build.ts",
    "check:desktop": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml --features desktop && cargo check --manifest-path src-tauri/Cargo.toml --features desktop",
    "check:architecture": "node scripts/check/check-architecture.ts",
    "check:i18n": "node scripts/check/check-i18n.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm check:architecture && pnpm check:i18n && oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test \"packages/*/tests/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:watch": "node --test --watch \"packages/*/tests/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "cli:build": "node scripts/dev/go.ts build",
    "cli:run": "node scripts/dev/go.ts run",
    "cli:vet": "node scripts/dev/go.ts vet",
    "cli:test": "node scripts/dev/go.ts test",
    "cli:fmt": "node scripts/dev/go.ts fmt",
    "cli:check": "node scripts/dev/go.ts check",
    "android:bind": "node scripts/dev/mobile.ts bind:android",
    "android:install": "node scripts/dev/mobile.ts install:android",
    "ios:bind": "node scripts/dev/mobile.ts bind:ios",
    "tauri": "tauri",
    "release:check": "node scripts/release/release-config.ts",
    "release:core": "node --env-file-if-exists=.env scripts/release/build-release.ts",
    "release:desktop": "node --env-file-if-exists=.env scripts/release/build-desktop-release.ts",
    "release:android": "node --env-file-if-exists=.env scripts/release/release-android.ts",
    "release:ios": "node --env-file-if-exists=.env scripts/release/release-ios.ts",
    "release:image": "node scripts/release/build-release-image.ts",
    "release:assemble": "node --env-file-if-exists=.env scripts/release/release-ci.ts assemble",
    "ui:add": "pnpm dlx shadcn@latest add -c packages/client-ui",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxc-parser": "^0.150.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.82.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.10.1"
}
